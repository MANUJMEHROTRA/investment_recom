# Copy to .env and adjust. All optional - defaults work out of the box.

# Postgres credentials (local only)
POSTGRES_USER=invest
POSTGRES_PASSWORD=invest
POSTGRES_DB=invest

# Your own watchlist instead of the built-in ~65 large caps + ETFs (comma separated)
# UNIVERSE=AAPL,MSFT,NVDA,AMZN,GOOGL,META,COST,JPM,LLY,XOM,QQQ

# ---- News agent -------------------------------------------------------------
# LLM for reading news and writing the reasoning: auto | ollama | anthropic | none
#   auto = local Ollama if it is running, else Claude if a key is set, else rules-only
LLM_PROVIDER=auto
OLLAMA_MODEL=qwen2.5:7b
# Optional, paid: Claude API (https://console.anthropic.com). Leave blank to stay free.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Optional, free: https://finnhub.io/register - adds wire-service company & market news
FINNHUB_API_KEY=
# SEC asks automated clients to identify themselves: "<app name> <your email>"
SEC_USER_AGENT=StockCompass personal-research you@example.com

# ---- India-based investor --------------------------------------------------------
# Your bank/broker's USD/INR spread, each way (e.g. 1.0 = 1%)
FX_MARKUP_PCT=1.0

# Pre-market brief time, America/New_York (7:30 ET = 17:00 IST in US summer, 18:00 in winter)
BRIEF_HOUR=7
BRIEF_MINUTE=30

# How many picks get a suggested position weight
TOP_N=10

# Daily run time, America/New_York (after the 16:00 close)
SCHEDULE_HOUR=17
SCHEDULE_MINUTE=0

# On a brand-new database, replay the model over this many past trading days
BACKFILL_DAYS_ON_FIRST_START=60

# Set to false to skip Yahoo fundamentals (faster, fewer requests)
FETCH_FUNDAMENTALS=true

# Origins allowed to call the API. Add your GitHub Pages URL if the username differs.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://manujmehrotra.github.io
